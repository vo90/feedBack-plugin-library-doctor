{
  "id": "library_doctor",
  "name": "Library Doctor",
  "version": "0.45.0",
  "private": false,
  "description": "Scan, diagnose, safely repair, and use focused tools on the local FeedBack song library.",
  "category": "tools",
  "icon": "assets/thumb.svg",
  "nav": { "label": "Library Doctor", "screen": "plugin-library_doctor" },
  "screen": "screen.html",
  "script": "screen.js",
  "scriptType": "module",
  "minHost": "0.3.0-alpha.1",
  "standards": ["capability-pipelines.v1", "plugin-runtime-idempotent.v1"],
  "capabilities": {
    "playback": {
      "roles": ["requester", "observer"],
      "requests": ["inspect", "start", "pause", "resume", "seek", "stop"],
      "observes": ["ready", "started", "paused", "resumed", "seeking", "seeked", "ended", "stopped"],
      "mode": "active",
      "compatibility": "none",
      "ownership": "requester-only",
      "safety": "safe",
      "version": 1
    },
    "chart-transform": {
      "roles": ["provider"],
      "operations": ["chart.transform"],
      "mode": "active",
      "compatibility": "none",
      "ownership": "multi-provider",
      "safety": "safe",
      "version": 1
    }
  },
  "styles": "assets/library-doctor.css",
  "routes": "routes.py",
  "diagnostics": {
    "callable": "diagnostics:collect"
  }
}
